<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text color="#555555" font-size="15px" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="40px 24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#222222">Security deposit required</mj-text>
        <mj-text>Hi {{ guest_first_name }},</mj-text>
        <mj-text>A security deposit of <strong>{{ amount }} {{ currency }}</strong> is required for booking <strong>{{ booking_reference }}</strong> ({{ property_name }}, {{ date_from }} – {{ date_to }}). Please arrange this by {{ due_on }}.</mj-text>
        <mj-text>The deposit is fully refundable after check-out, less any damage charges.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
