<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text color="#555555" font-size="15px" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="40px 24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#222222">Please refresh your stored card</mj-text>
        <mj-text>Hi {{ guest_first_name }},</mj-text>
        <mj-text>Your stored card may have expired. Please refresh your card details before we charge <strong>{{ amount }} {{ currency }}</strong> for booking <strong>{{ booking_reference }}</strong> ({{ property_name }}, {{ date_from }} – {{ date_to }}) on <strong>{{ due_on }}</strong>.</mj-text>
        <mj-text>Reply to this email if you'd like a fresh payment link.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
