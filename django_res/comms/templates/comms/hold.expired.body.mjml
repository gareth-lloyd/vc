<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text color="#555555" font-size="15px" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="40px 24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#222222">A hold has expired</mj-text>
        <mj-text>Hi {{ agent_name }},</mj-text>
        <mj-text>The hold on <strong>{{ property_name }}</strong> for <strong>{{ date_from }}</strong> – <strong>{{ date_to }}</strong> has now lapsed.</mj-text>
        <mj-text>Quotation reference: <strong>{{ quotation_reference }}</strong></mj-text>
        <mj-text color="#888888" font-size="13px">If the guest still wants the dates, you'll need to re-confirm availability and issue a fresh quote.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
