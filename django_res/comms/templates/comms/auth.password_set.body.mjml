<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text color="#555555" font-size="15px" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="40px 24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#222222">Welcome to Villa Collective</mj-text>
        <mj-text>Hi {{ user_first_name }},</mj-text>
        <mj-text>A Villa Collective account has been created for you. Use the button below to set your password and finish setting up your account.</mj-text>
        <mj-button href="{{ setup_url }}" background-color="#222222" color="#ffffff" padding="20px 0">Complete account setup</mj-button>
        <mj-text color="#888888" font-size="13px">Once your password is set you can sign in any time with your email and password.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
