<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text color="#555555" font-size="15px" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="40px 24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#222222">Your booking contract</mj-text>
        <mj-text>Hi {{ guest_first_name }},</mj-text>
        <mj-text>Your contract for <strong>{{ property_name }}</strong>, {{ date_from }} to {{ date_to }}, is attached to this email as <strong>{{ document_filename }}</strong>.</mj-text>
        <mj-text>It sets out the terms of your stay and the house rules for the property, so please read it and keep it for your records. Your booking reference is <strong>{{ booking_reference }}</strong>.</mj-text>
        <mj-text color="#888888" font-size="13px">If anything in the contract doesn't look right, reply to this email and we'll sort it out.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
