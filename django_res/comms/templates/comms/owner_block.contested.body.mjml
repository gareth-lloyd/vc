<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text color="#555555" font-size="15px" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="40px 24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#222222">A quick check on your blocked dates</mj-text>
        <mj-text>Our team has flagged the dates you blocked on <strong>{{ property_name }}</strong> and would like to check them with you.</mj-text>
        <mj-text>Dates: <strong>{{ date_from }}</strong> – <strong>{{ date_to }}</strong></mj-text>
        <mj-text>Note from our team: {{ reason }}</mj-text>
        <mj-text color="#888888" font-size="13px">Your block is still in place — nothing has changed on the calendar. Please reply or contact your Villa Collective representative so we can confirm the dates together.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
