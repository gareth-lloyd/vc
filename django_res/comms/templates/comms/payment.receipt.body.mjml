<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text color="#555555" font-size="15px" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="40px 24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#222222">Payment received</mj-text>
        <mj-text>Hi {{ guest_first_name }},</mj-text>
        <mj-text>We've received your payment of <strong>{{ amount }} {{ currency }}</strong> against booking <strong>{{ booking_reference }}</strong>.</mj-text>
        <mj-text>Reference: <strong>{{ payment_reference }}</strong></mj-text>
        <mj-text color="#888888" font-size="13px">Keep this email for your records.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
