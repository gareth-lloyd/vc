<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text color="#555555" font-size="15px" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="40px 24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#222222">Your quotation</mj-text>
        <mj-text>Hi {{ guest_first_name }},</mj-text>
        <mj-text>Please find your quotation for <strong>{{ property_name }}</strong> attached.</mj-text>
        <mj-text>Reply to this email and I'll be glad to help with any questions.</mj-text>
        <mj-text>Best,<br />{{ agent_name }}</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
