# Local dev: Postgres runs in docker compose at the matching port and creds.
# See docker-compose.yml at the repo root.
DATABASE_URL=postgres://villa:villa@localhost:55432/villacollective

# Authed iCal feed URL used as the default for `manage.py demo_ical --add-feed`.
# A private calendar share link is a bearer credential — keep it here, not in
# source. Leave unset to require an explicit --feed-url instead.
# DEMO_ICAL_FEED_URL=https://calendar.google.com/calendar/ical/…/private-…/basic.ics

# Zoho Flow outbound push webhooks (GAP-081). The zapikey lives in the URL,
# so each value is a credential — never commit real values. Empty = that
# kind's push is silently disabled.
ZOHO_FLOW_WEBHOOK_CONTACT=
ZOHO_FLOW_WEBHOOK_ENQUIRY=
ZOHO_FLOW_WEBHOOK_QUOTE=
ZOHO_FLOW_WEBHOOK_BOOKING=
