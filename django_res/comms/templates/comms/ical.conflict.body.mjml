<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text color="#555555" font-size="15px" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="40px 24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#222222">Calendar clash detected</mj-text>
        <mj-text>A calendar feed reported dates as unavailable that Villa Collective has <strong>already committed</strong> (a confirmed booking or an open quotation).</mj-text>
        <mj-text>Property: <strong>{{ property_name }}</strong></mj-text>
        <mj-text>Dates: <strong>{{ date_from }}</strong> – <strong>{{ date_to }}</strong></mj-text>
        <mj-text>Feed(s): {{ feed_labels }}</mj-text>
        <mj-text>Clashing VC {{ conflict_kind }}: <strong>{{ conflict_reference }}</strong></mj-text>
        <mj-text color="#888888" font-size="13px">The imported block was not written — the Villa Collective {{ conflict_kind }} stands. Please check the owner's other channel and resolve the clash.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
