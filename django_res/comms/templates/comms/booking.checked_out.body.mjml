<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text color="#555555" font-size="15px" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="40px 24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#222222">Thank you for your stay</mj-text>
        <mj-text>Hi {{ guest_first_name }},</mj-text>
        <mj-text>We hope you enjoyed your time at <strong>{{ property_name }}</strong>. Your booking <strong>{{ booking_reference }}</strong> is now complete.</mj-text>
        <mj-text>We'd love to host you again soon.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
