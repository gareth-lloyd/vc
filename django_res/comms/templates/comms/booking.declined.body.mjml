<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text color="#555555" font-size="15px" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="40px 24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#222222">Your booking request</mj-text>
        <mj-text>Hi {{ guest_first_name }},</mj-text>
        <mj-text>Unfortunately, your request for <strong>{{ property_name }}</strong> from <strong>{{ date_from }}</strong> to <strong>{{ date_to }}</strong> wasn't able to go ahead.</mj-text>
        <mj-text>Your reference was <strong>{{ booking_reference }}</strong>. Reply to this email and we'll be glad to help you find an alternative.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
