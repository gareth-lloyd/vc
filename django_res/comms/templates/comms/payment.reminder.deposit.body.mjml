<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text color="#555555" font-size="15px" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="40px 24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#222222">Deposit due today</mj-text>
        <mj-text>Hi {{ guest_first_name }},</mj-text>
        <mj-text>The deposit of <strong>{{ amount }} {{ currency }}</strong> on booking <strong>{{ booking_reference }}</strong> ({{ property_name }}, {{ date_from }} – {{ date_to }}) is due today.</mj-text>
        <mj-raw>
          {% if charge_breakdown.charges or charge_breakdown.discounts %}
          <p style="font-size:15px;color:#555555;line-height:22px;margin:16px 0 0;font-family:Helvetica,Arial,sans-serif;">Here's how your booking breaks down:</p>
          <table style="width:100%;border-collapse:collapse;margin:8px 0 16px;font-family:Helvetica,Arial,sans-serif;">
            <tbody>
              <tr>
                <td style="font-size:14px;color:#333333;border-bottom:1px solid #f0f0f0;padding:10px 6px;">Booking subtotal</td>
                <td style="font-size:14px;color:#333333;border-bottom:1px solid #f0f0f0;padding:10px 6px;text-align:right;">{{ charge_breakdown.currency }} {{ charge_breakdown.base_amount }}</td>
              </tr>
              {% for line in charge_breakdown.charges %}
              <tr>
                <td style="font-size:14px;color:#333333;border-bottom:1px solid #f0f0f0;padding:10px 6px;">{{ line.label }}</td>
                <td style="font-size:14px;color:#333333;border-bottom:1px solid #f0f0f0;padding:10px 6px;text-align:right;">{{ charge_breakdown.currency }} {{ line.amount }}</td>
              </tr>
              {% endfor %}
              {% if charge_breakdown.discounts %}
              <tr>
                <td colspan="2" style="font-size:13px;font-weight:bold;color:#2e7d32;padding:14px 6px 6px;">Discounts</td>
              </tr>
              {% for line in charge_breakdown.discounts %}
              <tr>
                <td style="font-size:14px;color:#2e7d32;border-bottom:1px solid #f0f0f0;padding:10px 6px;">{{ line.label }}</td>
                <td style="font-size:14px;color:#2e7d32;border-bottom:1px solid #f0f0f0;padding:10px 6px;text-align:right;">{{ charge_breakdown.currency }} {{ line.amount }}</td>
              </tr>
              {% endfor %}
              {% endif %}
              <tr>
                <td style="font-size:15px;font-weight:bold;color:#222222;border-top:2px solid #eeeeee;padding:12px 6px;">Booking total</td>
                <td style="font-size:15px;font-weight:bold;color:#222222;border-top:2px solid #eeeeee;padding:12px 6px;text-align:right;">{{ charge_breakdown.currency }} {{ charge_breakdown.total }}</td>
              </tr>
            </tbody>
          </table>
          {% endif %}
        </mj-raw>
        <mj-text>Reply to this email if you have any trouble completing the payment.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
