<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
      <mj-text color="#555555" font-size="15px" line-height="22px" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f4f4f4">
    <mj-section background-color="#ffffff" padding="40px 24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="bold" color="#222222">Reset your password</mj-text>
        <mj-text>Hi {{ user_first_name }},</mj-text>
        <mj-text>We received a request to reset the password on your Villa Collective account. Open the link below within {{ expires_in_minutes }} minutes to set a new one.</mj-text>
        <mj-button href="{{ reset_url }}" background-color="#222222" color="#ffffff" padding="20px 0">Reset your password</mj-button>
        <mj-text color="#888888" font-size="13px">If you didn't ask for this, you can ignore this email — your password won't change.</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
